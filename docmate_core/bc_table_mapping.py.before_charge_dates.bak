"""OCR to the supplied Purchase Header (38)/Purchase Line (39) captions.

This is a SQL handoff contract for the external sender, not a native API body.
Only observed values are emitted; BC identifiers are never inferred from OCR.

The tag mapping lives in bc_field_mapping.json so support can maintain it
(Admin > BC Field Mapping) without code changes. The defaults below are used
only when that file does not exist.

VAT follows BC: line VAT is not sent (BC calculates it with the company rounding
rules). DocMate recalculates VAT per tax band (lines at 5 decimals, band totals at
2) and compares it with the invoice VAT; a difference within the allowed tolerance
is reported as the VAT difference, anything larger is held for review.
"""
from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
import json
import math
from pathlib import Path
import re

from .pdf_evidence import PdfEvidence


MAPPING_FILE = Path(__file__).resolve().parent / 'bc_field_mapping.json'
FIELD_TYPES = ('text', 'decimal', 'integer', 'date')
SECTIONS = ('header', 'lines')

# A printed "Discount" column is stored as the tag 'discount' without saying whether it
# is a % or an amount; a supplier rule decides which BC field it goes to.
DISCOUNT_TAG = 'discount'
DISCOUNT_PERCENT = 'Line Discount %'
DISCOUNT_AMOUNT = 'Line Discount Amount'
PRICES_INCL_VAT = 'Prices Including VAT'

# Delivery/shipping/freight charges are moved from the header to a line item with this fixed code.
# BC handles it per client setup (non-stock item, G/L account, charge item, etc.).
DELIVERY_ITEM_CODE = 'DELIVERY'
DELIVERY_DESCRIPTION = 'Delivery Charge'
DELIVERY_HEADER_TAGS = ('shippingAmount', 'deliveryCharge', 'freightAmount')

DEFAULT_VAT_RULES = {'maxVatDifference': 0.01, 'lineRoundingDecimals': 5}

# Values DocMate adds about the extraction itself, never printed on the PDF.
SYSTEM_TAGS = {'extractionMode'}
# DocMate numbers the lines, but BC needs the line number in the line data.
ALWAYS_IN_DATA = {'Line No.'}
# A printed zero is real only where zero means something (e.g. VAT 0.00, VAT 0%);
# elsewhere (quantity, unit cost, por...) a zero is DocMate's placeholder for "not on the PDF".
ZERO_MEANINGFUL = {'Amount', 'Doc. Amount VAT', 'Doc. Amount Incl. VAT', 'VAT %', 'Amount Including VAT'}
_ISO_DATE = re.compile(r'^\d{4}-\d{2}-\d{2}$')

# Patterns that identify non-business noise in PDF notes/blocks (T&C, legal, help text, payment how-to).
_NOTE_NOISE = re.compile(
    r'terms\s+(?:and|&)\s+(?:conditions|services)'
    r'|(?:check|see)\s+(?:our|the)\s+FAQ'
    r'|contact\s+us\s+at'
    r'|www\.\S+\.\S+'
    r'|billing\s+permissions'
    r'|under\s+article\s+\d'
    r'|council\s+directive'
    r'|pay\s+by\s+(?:credit\s+card|wire\s+transfer|cheque|check)'
    r'|subject\s+to\s+(?:VAT|tax)'
    r'|how\s+to\s+pay'
    r'|customer\s+terms'
    r'|@\w+\.\w+'
    r'|privacy\s+policy'
    r'|all\s+(?:fees|rights)\s+(?:are|reserved)'
    r'|need\s+help\s+interpreting'
    r'|manage\s+your\s+subscription'
    r'|visit\s+your\s+account'
    r'|requires?\s+that\s+you\s+have'
    r'|terms\s+that\s+apply'
    r'|help\s+(?:interpreting|understanding)'
    r'|\bFAQs?\b.*billing',
    re.IGNORECASE,
)

