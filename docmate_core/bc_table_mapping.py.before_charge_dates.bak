def is_excluded_field(field):
    """Z_ codes describe intentional exclusions, never writable BC fields."""
    return str(field).startswith('Z_')


def apply_confirmed_mapping(config):
    """Apply confirmed pilot decisions, retaining unrelated support configuration."""
    for section, exclusions in CONFIRMED_EXCLUSIONS.items():
        tags = {tag for aliases in exclusions.values() for tag in aliases}
        if section == 'header':
            tags.update(('customerNumber', 'customerNo'))
        retained = []
        for entry in config[section]:
            aliases = [tag for tag in entry['docmateTags'] if tag not in tags]
            if aliases:
                retained.append(dict(entry, docmateTags=aliases))
        for code, aliases in exclusions.items():
            retained.append({'bcField': 'Z_' + code, 'docmateTags': aliases, 'type': 'text'})
        if section == 'header':
            vendor = next((e for e in retained if e['bcField'] == 'Buy-from Vendor No.'), None)
            if vendor:
                vendor['docmateTags'] = ['customerNumber', 'customerNo'] + vendor['docmateTags']
            else:
                retained.append({'bcField': 'Buy-from Vendor No.',
                                 'docmateTags': ['customerNumber', 'customerNo'], 'type': 'text'})
        config[section] = retained
    return config


apply_confirmed_mapping(DEFAULT_FIELD_MAPPING)


